# ── Backend ──────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./carbonlanka.db
# For production: postgresql+asyncpg://user:pass@localhost:5432/carbonlanka

# Carbon credit pricing (USD per tonne)
CARBON_PRICE_MIN=8.0
CARBON_PRICE_MAX=15.0

# LKR exchange rate (update daily in prod)
USD_TO_LKR=310.0

# Google Earth Engine service account key path
GEE_SERVICE_ACCOUNT_KEY=./gee-service-account.json
GEE_PROJECT_ID=your-gee-project-id

# ── Blockchain ───────────────────────────────────────────
# Polygon Amoy testnet RPC (replaced deprecated Mumbai)
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
# Polygon Mainnet RPC
POLYGON_MAINNET_RPC=https://polygon-rpc.com

# Deployer private key — also holds VERIFIER_ROLE for server-side minting
# NEVER commit the real key!
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed contract address (filled after running: npx hardhat run scripts/deploy.js --network amoy)
CARBON_CREDIT_CONTRACT_ADDRESS=

# Set to "true" to use real Polygon transactions (requires deployed contract + funded wallet)
# When "false", backend simulates tx hashes for demo without chain
USE_REAL_BLOCKCHAIN=false

# Polygonscan API key for contract verification
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# ── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_CONTRACT_ADDRESS=
VITE_CHAIN_ID=80002
# 80002 = Amoy testnet | 137 = Polygon mainnet
